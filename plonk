#!/usr/bin/env bash
# plonk — collapse Hyprland workspaces down to the lowest numbers.
#
# Renumbers by moving the windows and pinning the new workspace to the old
# monitor (every bar handles those events). PLONK_RENUMBER=change_id (or
# ~/.config/plonk/renumber) uses hl.dsp.workspace.change_id instead, which
# keeps the tiling layout but ghosts the old number in bars that ignore the
# changeworkspaceid event (stock Omarchy bar on Quickshell 0.3.1). change_id
# still falls back to moving when the target ID is taken or it fails.
# Special/scratchpad workspaces (id < 1) and named workspaces are left alone.
# Titles from the nixfred.workspace-names plugin (workspace-names.json, keyed
# by id) travel with the workspace when it is renumbered; override the file
# with WORKSPACE_NAMES_FILE.
# If you were sitting on an empty workspace you land on the first free slot
# after the compacted ones. Silent by default: --notify adds a desktop
# notification (omarchy-notification-send / notify-send) in any mode.
#
# --watch keeps running and auto-plonks when a hole actually appears
# (window opened above a gap, last window closed/moved off a workspace,
# workspace destroyed, monitor unplugged) and once on connect — not on
# every workspace switch. Quiet, never fills or steals
# focus from the empty workspace you are sitting on (unless
# empty_active=fill, see below), pauses while the hyprshell/Swish overlay
# is open. Needs socat.
#
# Usage: plonk [-n|--dry-run] [--notify] | plonk --watch [--notify]
set -euo pipefail

if [[ ${WORKSPACE_NAMES_FILE+x} ]]; then
  NAMES_FILE=$WORKSPACE_NAMES_FILE
elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
  NAMES_FILE=$XDG_CONFIG_HOME/omarchy/workspace-names.json
elif [[ -n ${HOME:-} ]]; then
  NAMES_FILE=$HOME/.config/omarchy/workspace-names.json
else
  NAMES_FILE=
fi

# State dir (lock, names backups, notify stamp). Like NAMES_FILE, must work
# without HOME (minimal service environments): empty means "no state dir",
# and every user of it degrades gracefully.
if [[ -n ${PLONK_STATE_DIR:-} ]]; then
  STATE_DIR=$PLONK_STATE_DIR
elif [[ -n ${XDG_STATE_HOME:-} ]]; then
  STATE_DIR=$XDG_STATE_HOME/plonk
elif [[ -n ${HOME:-} ]]; then
  STATE_DIR=$HOME/.local/state/plonk
else
  STATE_DIR=
fi

# Options. Environment wins, then ~/.config/plonk/config (key=value lines,
# "#" comments), then the legacy one-line ~/.config/plonk/renumber file.
# Re-read on every compact, so the daemon follows the file without a restart.
#
#   renumber=move|change_id   (PLONK_RENUMBER)
#     "move" (default) moves the windows and pins the new workspace to the
#     old monitor; every bar follows the resulting create/destroy events.
#     "change_id" uses hl.dsp.workspace.change_id, which keeps the tiling
#     layout but emits changeworkspaceid — an event Quickshell 0.3.1
#     ignores, so the stock Omarchy bar shows the old number as a ghost.
#   empty_active=keep|fill    (PLONK_EMPTY_ACTIVE)
#     What --watch does when the workspace you are ON becomes empty. "keep"
#     (default) leaves it; the hole closes when you switch away. "fill"
#     jumps you to the next occupied workspace on that monitor right away —
#     after a short grace (PLONK_FILL_DELAY_MS, default 300) so a window you
#     open in the same breath still lands where you were — and the compact
#     then renumbers it down.
if [[ -n ${XDG_CONFIG_HOME:-} ]]; then
  CONFIG_DIR=$XDG_CONFIG_HOME/plonk
elif [[ -n ${HOME:-} ]]; then
  CONFIG_DIR=$HOME/.config/plonk
else
  CONFIG_DIR=
fi
RENUMBER=move
EMPTY_ACTIVE=keep
CONFIG_WARNED=
config_warn() { # once per process: a daemon must not repeat this every round
  [[ -n $CONFIG_WARNED ]] && return 0
  echo "plonk: $1" >&2
  CONFIG_WARNED=1
}
# Only a plain regular file, never a symlink, bounded in size.
config_file_usable() {
  local f=$1 size
  [[ -n $f && -f $f && ! -L $f ]] || return 1
  size=$(stat -c %s -- "$f" 2>/dev/null) || return 1
  (( size <= 65536 ))
}
read_config() {
  local renumber=${PLONK_RENUMBER:-} empty=${PLONK_EMPTY_ACTIVE:-} line key val n=0
  if [[ -n $CONFIG_DIR ]] && config_file_usable "$CONFIG_DIR/config"; then
    while IFS= read -r line || [[ -n $line ]]; do
      (( ++n > 64 )) && break
      line=${line%%#*}
      line=${line//[[:space:]]/}
      [[ -n $line && $line == *=* ]] || continue
      key=${line%%=*}
      val=${line#*=}
      case "$key" in
        renumber)     [[ -n $renumber ]] || renumber=$val ;;
        empty_active) [[ -n $empty ]] || empty=$val ;;
        *) config_warn "unknown option '$key' in $CONFIG_DIR/config (ignored)" ;;
      esac
    done <"$CONFIG_DIR/config"
  fi
  if [[ -z $renumber && -n $CONFIG_DIR ]] && config_file_usable "$CONFIG_DIR/renumber"; then
    IFS= read -r -n 32 renumber <"$CONFIG_DIR/renumber" || true
    renumber=${renumber//[[:space:]]/}
  fi
  case "${renumber:-move}" in
    move|change_id) RENUMBER=${renumber:-move} ;;
    *) config_warn "unknown renumber mode '$renumber' (want move or change_id); moving windows"; RENUMBER=move ;;
  esac
  case "${empty:-keep}" in
    keep|fill) EMPTY_ACTIVE=${empty:-keep} ;;
    *) config_warn "unknown empty_active mode '$empty' (want keep or fill); keeping"; EMPTY_ACTIVE=keep ;;
  esac
}

usage() { echo "Usage: plonk [-n|--dry-run] [--notify] | plonk --watch [--notify]" >&2; }

dry=0
watch=0
quiet=0
keep_empty_active=0
notify_en=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) dry=1 ;;
    -w|--watch) watch=1 quiet=1 keep_empty_active=1 ;;
    --notify) notify_en=1 ;;
    -h|--help)
      echo "Usage: plonk [-n|--dry-run] [--notify] | plonk --watch [--notify]"
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done
if ((dry && watch)); then usage; exit 2; fi
if (($# > 2)); then usage; exit 2; fi

for c in hyprctl jq; do command -v "$c" >/dev/null || { echo "plonk: $c not found" >&2; exit 1; }; done

# Watch-mode bookkeeping. A manual run ignores these, but the daemon uses
# them to distinguish events produced by its own window-move fallback from a
# real second hole that arrives while it is settling. Window addresses are
# keyed WITHOUT the 0x prefix: `hyprctl clients -j` reports "0x5587fd748d40"
# but socket2 events carry the bare hex ("movewindowv2>>5587fd748d40,3,3").
COMPACT_LOCK_SKIPPED=0
declare -A OWN_MOVES=() OWN_DESTROYS=() OWN_WSMOVES=()

clear_own_events() {
  OWN_MOVES=()
  OWN_DESTROYS=()
  OWN_WSMOVES=()
}

hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

# The state dir must be a real directory (never a planted symlink) before
# anything is written under it. Backups and the notify stamp go through this.
state_dir_ok() {
  [[ -n $STATE_DIR && ! -L $STATE_DIR ]] || return 1
  mkdir -p -m 700 "$STATE_DIR" 2>/dev/null || return 1
  [[ -d $STATE_DIR && ! -L $STATE_DIR ]]
}

# Only one plonk at a time: the SUPER+MINUS manual run and the --watch
# daemon otherwise race each other mid-compact (double renumbering,
# interleaved names-file rewrites). Waits briefly, then skips this round —
# the holder is compacting anyway. The lock is flock(2) on the state
# DIRECTORY itself, opened read-only: no lock file is created, so nothing on
# a predictable path is ever opened for writing or truncated (marketplace
# review #2941). The lock lives exactly as long as one compact: fd 9 is
# closed on the way out (a long-lived daemon must not keep holding it).
compact() {
  local rc=0
  COMPACT_LOCK_SKIPPED=0
  if state_dir_ok && command -v flock >/dev/null; then
    if { exec 9<"$STATE_DIR"; } 2>/dev/null; then
      if ! flock -w "${PLONK_LOCK_WAIT:-3}" 9 2>/dev/null; then
        exec 9>&-
        COMPACT_LOCK_SKIPPED=1
        echo "plonk: another plonk is compacting; skipping" >&2
        return 0
      fi
    fi
  fi
  compact_unlocked || rc=$?
  exec 9>&- 2>/dev/null || true
  return "$rc"
}

compact_unlocked() {
  local active snapshot_active current_active clients workspaces monitors new_active moves target active_seen ws mon active_windows skip_target names_warned=
  read_config
  active=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $active =~ ^-?[0-9]+$ ]] || { echo "plonk: could not read active workspace" >&2; return 1; }

  clients=$(hyprctl clients -j)
  workspaces=$(hyprctl workspaces -j)
  monitors=$(hyprctl monitors -j 2>/dev/null || echo '[]')
  # The four hyprctl reads are not atomic. Re-sample focus after the slower
  # snapshots so the empty-active guard is based on where the user is now,
  # not where they were before clients/workspaces were collected.
  snapshot_active=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $snapshot_active =~ ^-?[0-9]+$ ]] || { echo "plonk: could not re-read active workspace" >&2; return 1; }
  active=$snapshot_active
  new_active=$active
  moves=0

  local -A taken=() blocked=()
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ ]] && taken[$id]=1
  done < <(jq -r '.[] | select(.id > 0) | .id' <<<"$workspaces")
  # An EMPTY workspace another monitor is showing right now is not a hole:
  # landing there would merge windows into it and then drag it off that head.
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ && $id != "$active" ]] && blocked[$id]=1
  done < <(jq -r --argjson ws "$workspaces" '.[]? | select(.focused != true) | .activeWorkspace.id? // empty
      | select(. > 0) | . as $id | ($ws | map(select(.id == $id)) | first // {windows: 0}) | select(.windows == 0) | $id' <<<"$monitors" 2>/dev/null)
  # Named workspaces keep a numeric id. Never land on those — change_id would
  # fail (id taken, rc=0) and the window-move fallback would merge into them.
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ ]] && blocked[$id]=1
  done < <(jq -r '.[] | select(.id > 0 and ((.name // "") | test("^[0-9]+$") | not)) | .id' <<<"$workspaces")

  move_windows() { # src dst
    local src=$1 dst=$2
    OWN_DESTROYS[$src]=1
    while IFS= read -r addr; do
      [[ -n $addr && $addr != null ]] || continue
      OWN_MOVES["${addr#0x},$dst"]=1
      hypr_dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$dst\", follow = false })" \
        movetoworkspacesilent "$dst,address:$addr"
    done < <(jq -r --argjson w "$src" '.[] | select(.workspace.id == $w) | .address' <<<"$clients")
  }

  # Snapshot the names file before plonk rewrites it (keeps the last 20 in
  # $XDG_STATE_HOME/plonk/names-backups, or $PLONK_STATE_DIR) so a bad remap
  # is always recoverable: ls -t ~/.local/state/plonk/names-backups | head.
  backup_names() {
    state_dir_ok || return 0
    local dir="$STATE_DIR/names-backups"
    [[ -L $dir ]] && return 0
    mkdir -p -m 700 "$dir" 2>/dev/null || return 0
    cp -p -- "$NAMES_FILE" "$dir/workspace-names.$(date +%Y%m%d-%H%M%S.%N).json" 2>/dev/null || return 0
    ls -1t "$dir"/workspace-names.*.json 2>/dev/null | tail -n +21 | xargs -r rm -f --
  }

  # The names file is user-writable config that another program owns. Only a
  # plain regular file of sane size is ever opened: a symlink is never
  # followed, a FIFO never read (jq would block the watcher forever), and an
  # oversized file never parsed (marketplace review #2941).
  names_file_usable() {
    local size
    [[ -f $NAMES_FILE && ! -L $NAMES_FILE ]] || return 1
    size=$(stat -c %s -- "$NAMES_FILE" 2>/dev/null) || return 1
    (( size <= ${PLONK_NAMES_MAX_BYTES:-1048576} ))
  }

  # Carry a workspace-names.json title (nixfred.workspace-names plugin, keyed
  # by workspace id) from src to dst so labels never land on the wrong number.
  # Atomic write like the workspace-name tool; no-op without file/name.
  remap_name() { # src dst
    local src=$1 dst=$2 tmp
    [[ -n $NAMES_FILE ]] || return 0
    [[ -e $NAMES_FILE || -L $NAMES_FILE ]] || return 0
    if ! names_file_usable; then
      if [[ -z ${names_warned:-} ]]; then
        echo "plonk: $NAMES_FILE is not a regular file under ${PLONK_NAMES_MAX_BYTES:-1048576} bytes; workspace titles NOT remapped" >&2
        names_warned=1
      fi
      return 0
    fi
    [[ -s $NAMES_FILE ]] || return 0
    # Only a NAMED workspace carries its title along. An unnamed workspace
    # arriving on a slot leaves whatever title is there alone — titles are
    # sticky to the slot and plonk never deletes one on its own (2026-08-22:
    # the "clear stale label" experiment wiped Fred's names; never again).
    if ! jq -e 'type == "object"' "$NAMES_FILE" >/dev/null 2>&1; then
      # Unreadable/invalid names file: compact anyway, but say so — a title
      # silently left on the old number is exactly the "names got murdered"
      # symptom.
      if [[ -z ${names_warned:-} ]]; then
        echo "plonk: cannot parse $NAMES_FILE; workspace titles NOT remapped" >&2
        names_warned=1
      fi
      return 0
    fi
    jq -e --arg s "$src" 'has($s)' "$NAMES_FILE" >/dev/null 2>&1 || return 0
    backup_names
    tmp=$(mktemp "${NAMES_FILE}.XXXXXX") || return 0
    if jq --arg s "$src" --arg d "$dst" '.[$d] = .[$s] | del(.[$s])' "$NAMES_FILE" >"$tmp" 2>/dev/null; then
      mv "$tmp" "$NAMES_FILE"
    else
      rm -f "$tmp"
    fi
  }

  renumber() { # src dst mon
    local src=$1 dst=$2 mon=$3 out
    if [[ $RENUMBER == change_id && -z ${taken[$dst]+x} ]]; then
      # hyprctl exits 0 even on failure ("warning: ... ID is taken" /
      # "no such workspace" go to stdout); only the literal "ok" is success.
      out=$(hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = \"$src\", id = $dst })" 2>/dev/null || true)
      if [[ $out == ok ]]; then
        unset "taken[$src]"
        taken[$dst]=1
        remap_name "$src" "$dst"
        return 0
      fi
    fi
    move_windows "$src" "$dst"
    OWN_WSMOVES[$dst]=1
    hypr_dispatch "hl.dsp.workspace.move({ workspace = \"$dst\", monitor = \"$mon\" })" \
      moveworkspacetomonitor "$dst" "$mon"
    taken[$dst]=1
    unset "taken[$src]"   # src is empty now; a later pass may change_id onto it
    remap_name "$src" "$dst"
  }

  notify() { # headline — coalesced: at most one notification per 2 seconds
    local stamp now last
    if state_dir_ok; then
      stamp="$STATE_DIR/last-notify"
      now=$(date +%s)
      if [[ -f $stamp && ! -L $stamp ]]; then
        last=$(stat -c %Y -- "$stamp" 2>/dev/null || echo 0)
        ((now - last < 2)) && return 0
      fi
      [[ -L $stamp ]] || touch -- "$stamp" 2>/dev/null
    fi
    if command -v omarchy-notification-send >/dev/null; then
      omarchy-notification-send --app-name plonk -g 󰕴 -u low "plonk" "$1" -t 1500 >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null; then
      notify-send -a plonk -u low -t 1500 "plonk" "$1" >/dev/null 2>&1 || true
    fi
  }

  # empty_active=fill: the workspace under the user just emptied. After the
  # grace (a window opened in the same breath must still land here), confirm
  # it is still empty and still focused, then jump to the next occupied
  # numeric workspace on the same monitor. Hyprland drops the empty one and
  # the resulting events start a fresh round that renumbers as usual.
  # Returns 0 when we jumped.
  fill_under_user() { # active
    local a=$1 mon next delay_ms now_active now_windows
    mon=$(jq -r --argjson a "$a" '[.[] | select(.id == $a) | .monitor] | first // empty' <<<"$workspaces")
    [[ -n $mon ]] || return 1
    next=$(jq -r --argjson a "$a" --arg m "$mon" \
      '[.[] | select(.id > $a and .windows > 0 and .monitor == $m and ((.name // "") | test("^[0-9]+$"))) | .id] | min // empty' <<<"$workspaces")
    [[ -n $next ]] || return 1
    delay_ms=${PLONK_FILL_DELAY_MS:-300}
    [[ $delay_ms =~ ^[0-9]+$ ]] || delay_ms=300
    if ((delay_ms > 0)); then sleep "$((delay_ms / 1000)).$(printf '%03d' $((delay_ms % 1000)))"; fi
    now_active=$(hyprctl activeworkspace -j | jq -r '.id')
    [[ $now_active == "$a" ]] || return 1
    now_windows=$(hyprctl workspaces -j | jq -r --argjson a "$a" '[.[] | select(.id == $a) | .windows] | first // 0')
    [[ $now_windows == 0 ]] || return 1
    hypr_dispatch "hl.dsp.focus({ workspace = \"$next\" })" workspace "$next"
    echo "plonk: workspace $a emptied under you; moved to $next" >&2
    return 0
  }

  active_windows=$(jq -r --argjson a "$active" '[.[] | select(.id == $a) | .windows] | first // 0' <<<"$workspaces")
  skip_target=0
  if ((keep_empty_active && active > 0 && active_windows == 0)); then
    if [[ $EMPTY_ACTIVE == fill ]] && fill_under_user "$active"; then
      return 0
    fi
    skip_target=$active
  fi

  target=1
  active_seen=0
  while IFS=$'\t' read -r ws mon; do
    [[ $ws =~ ^[0-9]+$ ]] || continue
    ((ws == active)) && active_seen=1
    while ((skip_target != 0 && target == skip_target)) || [[ -n ${blocked[$target]+x} ]]; do
      target=$((target + 1))
    done
    if ((ws != target)); then
      if ((dry)); then
        echo "would plonk workspace $ws -> $target ($mon)"
      else
        renumber "$ws" "$target" "$mon"
        if ((quiet)); then echo "plonk: plonked workspace $ws -> $target ($mon)" >&2
        else echo "plonked workspace $ws -> $target ($mon)"; fi
      fi
      if ((ws == active)); then new_active=$target; fi
      moves=$((moves + 1))
    fi
    target=$((target + 1))
  done < <(jq -r '.[] | select(.id > 0 and .windows > 0 and ((.name // "") | test("^[0-9]+$"))) | "\(.id)\t\(.monitor)"' <<<"$workspaces" | sort -n)

  # Sitting on an empty workspace above the pack? Land on the first free slot.
  if ((keep_empty_active == 0 && active_seen == 0 && active > target)); then
    new_active=$target
    ((dry)) && echo "would move focus $active -> $target (empty workspace)"
  fi

  if ((dry == 0 && new_active != active)); then
    # change_id normally carries focus with the workspace. The explicit focus
    # is only needed for the window-move fallback, and must never pull a user
    # back after they switched during this compact.
    current_active=$(hyprctl activeworkspace -j | jq -r '.id')
    if [[ $current_active == "$active" ]]; then
      hypr_dispatch "hl.dsp.focus({ workspace = \"$new_active\" })" workspace "$new_active"
    fi
  fi
  # Silent unless --notify was given: plonk does its work without reporting.
  if ((moves == 0)); then
    ((quiet)) || echo "plonk: Already Plonked!"
    if ((dry == 0 && notify_en)); then notify "Already Plonked!"; fi
  elif ((dry == 0 && notify_en)); then
    notify "Plonked $moves workspace$( ((moves == 1)) || echo s )"
  fi
}

watch_connection() {
  local dir inst sock candidate event_fd
  dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr"
  inst=${HYPRLAND_INSTANCE_SIGNATURE:-}
  sock="${dir}/${inst}/.socket2.sock"

  socket_live() {
    local candidate_sock=$1 candidate_inst
    candidate_inst=$(basename "$(dirname "$candidate_sock")")
    HYPRLAND_INSTANCE_SIGNATURE=$candidate_inst hyprctl monitors -j >/dev/null 2>&1
  }

  if [[ -z $inst || ! -S $sock ]] || ! socket_live "$sock"; then
    sock=
    while IFS= read -r candidate; do
      candidate=${candidate#* }
      if [[ -S $candidate ]] && socket_live "$candidate"; then
        sock=$candidate
        break
      fi
    done < <(find "$dir" -maxdepth 2 -name '.socket2.sock' -type s -printf '%T@ %p\n' 2>/dev/null | sort -nr)
  fi
  [[ -n ${sock:-} && -S $sock ]] || { echo "plonk: Hyprland event socket not found (${sock:-$dir})" >&2; return 1; }
  # hyprctl follows HYPRLAND_INSTANCE_SIGNATURE. If we found the socket by
  # search (Hyprland restarted under a daemon that outlived it), point hyprctl
  # at that same instance or every compact fails with "Couldn't connect".
  local found_inst; found_inst=$(basename "$(dirname "$sock")")
  if [[ -n $found_inst && $found_inst != "$inst" ]]; then
    export HYPRLAND_INSTANCE_SIGNATURE=$found_inst
    echo "plonk: using Hyprland instance $found_inst" >&2
  fi
  local paused=0 line ev payload need extra extra_ev extra_payload rounds move_addr move_rest move_dst destroy_id

  own_trigger() {
    local event=$1 event_payload=$2
    case "$event" in
      movewindow)   # ADDR,WORKSPACENAME
        [[ -n ${OWN_MOVES[${event_payload#0x}]+x} ]]
        ;;
      movewindowv2) # ADDR,WORKSPACEID,WORKSPACENAME
        move_addr=${event_payload%%,*}
        move_addr=${move_addr#0x}
        move_rest=${event_payload#*,}
        move_dst=${move_rest%%,*}
        [[ -n ${OWN_MOVES["$move_addr,$move_dst"]+x} ]]
        ;;
      destroyworkspace)
        [[ -n ${OWN_DESTROYS[$event_payload]+x} ]]
        ;;
      destroyworkspacev2)
        destroy_id=${event_payload%%,*}
        [[ -n ${OWN_DESTROYS[$destroy_id]+x} ]]
        ;;
      moveworkspace|moveworkspacev2) # WORKSPACEID,... — our fallback pins dst to its monitor
        [[ -n ${OWN_WSMOVES[${event_payload%%,*}]+x} ]]
        ;;
      *) return 1 ;;
    esac
  }

  is_compact_trigger() {
    case "$1" in
      openwindow|closewindow|movewindow|movewindowv2|destroyworkspace|destroyworkspacev2|moveworkspace|moveworkspacev2|monitoradded|monitorremoved|configreloaded)
        return 0 ;;
      *) return 1 ;;
    esac
  }

  # Settle for a bounded slice of WALL CLOCK (not "until the stream goes
  # idle"): Hyprland streams windowtitle events continuously (terminal title
  # spinners, browsers), so an idle-based read -t never returns and the
  # watcher would sit here forever, never compacting.
  drain() {
    local budget_us=${PLONK_SETTLE_US:-250000} now left
    local deadline=$(( ${EPOCHREALTIME//[.,]/} + budget_us ))
    while :; do
      now=${EPOCHREALTIME//[.,]/}
      left=$((deadline - now))
      ((left > 0)) || break
      printf -v left '%d.%06d' $((left / 1000000)) $((left % 1000000))
      IFS= read -r -t "$left" -u "$event_fd" extra || break
      extra_ev=${extra%%>>*}
      extra_payload=${extra#*>>}
      case "$extra_ev" in
        openlayer)  [[ $extra_payload == hyprshell_switch ]] && paused=1 ;;
        closelayer) [[ $extra_payload == hyprshell_switch ]] && { paused=0; need=1; } ;;
        # A hole that opens while we are settling must not be swallowed:
        # flag it so the loop below compacts again once this slice is over.
        *)
          if is_compact_trigger "$extra_ev" && ! own_trigger "$extra_ev" "$extra_payload"; then need=1; fi
          ;;
      esac
    done
  }

  need=0
  # Is the hyprshell/Swish switcher overlay actually up right now?
  overlay_open() {
    hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | .namespace? // empty] | any(. == "hyprshell_switch")' >/dev/null 2>&1
  }
  # Connect before the initial compact. Events that land during that first
  # snapshot are buffered on this fd and cannot fall through a startup gap.
  exec {event_fd}< <(socat -u UNIX-CONNECT:"$sock" -)
  SOCAT_PID=$!

  run_pending_compacts() {
    if ((need && paused)); then overlay_open || paused=0; fi
    rounds=0
    while ((need && paused == 0 && rounds < 5)); do
      need=0
      rounds=$((rounds + 1))
      clear_own_events
      # Compact immediately. The old pre-drain imposed a guaranteed 250 ms
      # delay; the post-drain still catches any event that races this snapshot
      # and schedules another bounded round.
      compact || true
      ((COMPACT_LOCK_SKIPPED)) && need=1
      drain
      clear_own_events
    done
  }

  # Holes that already exist when we connect (daemon start/restart, Hyprland
  # restart) would otherwise wait for the next unrelated event.
  need=1
  if overlay_open; then paused=1; else run_pending_compacts; fi

  while IFS= read -r -u "$event_fd" line; do
    ev=${line%%>>*}
    payload=${line#*>>}
    case "$ev" in
      openlayer)  [[ $payload == hyprshell_switch ]] && paused=1 ;;
      closelayer)
        if [[ $payload == hyprshell_switch ]]; then
          paused=0
          need=1
        fi
        ;;
      *)
        if is_compact_trigger "$ev" && ! own_trigger "$ev" "$payload"; then need=1; fi
        ;;
    esac
    # A pause set by openlayer can stick forever (daemon started while the
    # overlay was up, closelayer missed). Before letting it block a compact,
    # check whether the hyprshell layer actually exists.
    run_pending_compacts
  done
  exec {event_fd}<&-
  kill_socat
}

# The event reader is a process-substitution child. When the daemon is
# stopped (plugin disabled, shell restarted, systemctl stop) bash exits but
# that socat would linger, still connected to Hyprland, until the next event
# hits its dead pipe. Take it down with us.
SOCAT_PID=
kill_socat() {
  [[ -n ${SOCAT_PID:-} ]] || return 0
  kill "$SOCAT_PID" 2>/dev/null || true
  SOCAT_PID=
}

watch() {
  command -v socat >/dev/null || { echo "plonk: socat not found (needed for --watch)" >&2; return 1; }
  # Clean up, then die of the same signal (not `exit 143`): systemd and
  # Quickshell read "killed by SIGTERM" as a clean stop, but an exit CODE
  # of 143 after `systemctl stop` marks the unit failed.
  trap 'kill_socat; trap - TERM; kill -TERM $$' TERM
  trap 'kill_socat; trap - INT; kill -INT $$' INT
  trap 'kill_socat; trap - HUP; kill -HUP $$' HUP
  trap kill_socat EXIT

  while true; do
    watch_connection || true
    echo "plonk: event socket closed; reconnecting" >&2
    sleep "${PLONK_RECONNECT_DELAY:-1}"
  done
}

if ((watch)); then
  watch
else
  compact
fi
