#!/usr/bin/env bash
# plonk — collapse Hyprland workspaces down to the lowest numbers.
#
# Prefers hl.dsp.workspace.change_id so the workspace stays on its monitor
# and keeps its layout. Falls back to moving windows when the target ID is
# already taken (empty persistent workspace) or change_id is unavailable.
# Special/scratchpad workspaces (id < 1) and named workspaces are left alone.
# Titles from the nixfred.workspace-names plugin (workspace-names.json, keyed
# by id) travel with the workspace when it is renumbered; override the file
# with WORKSPACE_NAMES_FILE.
# If you were sitting on an empty workspace you land on the first free slot
# after the compacted ones. Sends a desktop notification when available
# (omarchy-notification-send / notify-send).
#
# --watch keeps running and auto-plonks when a hole actually appears
# (last window closed/moved off a workspace, workspace destroyed, monitor
# unplugged) — not on every workspace switch. Quiet, never fills or steals
# focus from the empty workspace you are sitting on, pauses while the
# hyprshell/Swish overlay is open. Needs socat.
#
# Usage: plonk [-n|--dry-run] | plonk --watch [--notify]
set -euo pipefail

if [[ ${WORKSPACE_NAMES_FILE+x} ]]; then
  NAMES_FILE=$WORKSPACE_NAMES_FILE
elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
  NAMES_FILE=$XDG_CONFIG_HOME/omarchy/workspace-names.json
elif [[ -n ${HOME:-} ]]; then
  NAMES_FILE=$HOME/.config/omarchy/workspace-names.json
else
  NAMES_FILE=
fi

usage() { echo "Usage: plonk [-n|--dry-run] | plonk --watch [--notify]" >&2; }

dry=0
watch=0
quiet=0
keep_empty_active=0
notify_en=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) dry=1 ;;
    -w|--watch) watch=1 quiet=1 keep_empty_active=1 ;;
    --notify) notify_en=1 ;;
    -h|--help)
      echo "Usage: plonk [-n|--dry-run] | plonk --watch [--notify]"
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done
if ((dry && watch)); then usage; exit 2; fi
if (($# > 2)); then usage; exit 2; fi

for c in hyprctl jq; do command -v "$c" >/dev/null || { echo "plonk: $c not found" >&2; exit 1; }; done

hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

compact() {
  local active clients workspaces monitors new_active moves target active_seen ws mon active_windows skip_target
  # Only one plonk at a time: the SUPER+MINUS manual run and the --watch
  # daemon otherwise race each other mid-compact (double renumbering,
  # interleaved names-file rewrites). Waits briefly, then skips this round —
  # the holder is compacting anyway.
  if command -v flock >/dev/null; then
    local lockdir="${PLONK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/plonk}"
    mkdir -p "$lockdir" 2>/dev/null || true
    { exec 9>"$lockdir/lock"; } 2>/dev/null || true
    if ! flock -w "${PLONK_LOCK_WAIT:-3}" 9 2>/dev/null; then
      echo "plonk: another plonk is compacting; skipping" >&2
      return 0
    fi
  fi
  active=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $active =~ ^-?[0-9]+$ ]] || { echo "plonk: could not read active workspace" >&2; return 1; }

  clients=$(hyprctl clients -j)
  workspaces=$(hyprctl workspaces -j)
  monitors=$(hyprctl monitors -j 2>/dev/null || echo '[]')
  new_active=$active
  moves=0

  local -A taken=() blocked=()
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ ]] && taken[$id]=1
  done < <(jq -r '.[] | select(.id > 0) | .id' <<<"$workspaces")
  # An EMPTY workspace another monitor is showing right now is not a hole:
  # landing there would merge windows into it and then drag it off that head.
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ && $id != "$active" ]] && blocked[$id]=1
  done < <(jq -r --argjson ws "$workspaces" '.[]? | select(.focused != true) | .activeWorkspace.id? // empty
      | select(. > 0) | . as $id | ($ws | map(select(.id == $id)) | first // {windows: 0}) | select(.windows == 0) | $id' <<<"$monitors" 2>/dev/null)
  # Named workspaces keep a numeric id. Never land on those — change_id would
  # fail (id taken, rc=0) and the window-move fallback would merge into them.
  while IFS= read -r id; do
    [[ $id =~ ^[0-9]+$ ]] && blocked[$id]=1
  done < <(jq -r '.[] | select(.id > 0 and ((.name // "") | test("^[0-9]+$") | not)) | .id' <<<"$workspaces")

  move_windows() { # src dst
    local src=$1 dst=$2
    while IFS= read -r addr; do
      [[ -n $addr && $addr != null ]] || continue
      hypr_dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$dst\", follow = false })" \
        movetoworkspacesilent "$dst,address:$addr"
    done < <(jq -r --argjson w "$src" '.[] | select(.workspace.id == $w) | .address' <<<"$clients")
  }

  # Snapshot the names file before plonk rewrites it (keeps the last 20 in
  # $XDG_STATE_HOME/plonk/names-backups, or $PLONK_STATE_DIR) so a bad remap
  # is always recoverable: ls -t ~/.local/state/plonk/names-backups | head.
  backup_names() {
    local dir="${PLONK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/plonk}/names-backups"
    mkdir -p "$dir" 2>/dev/null || return 0
    cp -p "$NAMES_FILE" "$dir/workspace-names.$(date +%Y%m%d-%H%M%S.%N).json" 2>/dev/null || return 0
    ls -1t "$dir"/workspace-names.*.json 2>/dev/null | tail -n +21 | xargs -r rm -f --
  }

  # Carry a workspace-names.json title (nixfred.workspace-names plugin, keyed
  # by workspace id) from src to dst so labels never land on the wrong number.
  # Atomic write like the workspace-name tool; no-op without file/name.
  remap_name() { # src dst
    local src=$1 dst=$2 tmp
    [[ -s $NAMES_FILE ]] || return 0
    # Only a NAMED workspace carries its title along. An unnamed workspace
    # arriving on a slot leaves whatever title is there alone — titles are
    # sticky to the slot and plonk never deletes one on its own (2026-08-22:
    # the "clear stale label" experiment wiped Fred's names; never again).
    jq -e --arg s "$src" 'type == "object" and has($s)' "$NAMES_FILE" >/dev/null 2>&1 || return 0
    backup_names
    tmp=$(mktemp "${NAMES_FILE}.XXXXXX") || return 0
    if jq --arg s "$src" --arg d "$dst" '.[$d] = .[$s] | del(.[$s])' "$NAMES_FILE" >"$tmp" 2>/dev/null; then
      mv "$tmp" "$NAMES_FILE"
    else
      rm -f "$tmp"
    fi
  }

  renumber() { # src dst mon
    local src=$1 dst=$2 mon=$3 out
    if [[ -z ${taken[$dst]+x} ]]; then
      # hyprctl exits 0 even on failure ("warning: ... ID is taken" /
      # "no such workspace" go to stdout); only the literal "ok" is success.
      out=$(hyprctl dispatch "hl.dsp.workspace.change_id({ workspace = \"$src\", id = $dst })" 2>/dev/null || true)
      if [[ $out == ok ]]; then
        unset "taken[$src]"
        taken[$dst]=1
        remap_name "$src" "$dst"
        return 0
      fi
    fi
    move_windows "$src" "$dst"
    hypr_dispatch "hl.dsp.workspace.move({ workspace = \"$dst\", monitor = \"$mon\" })" \
      moveworkspacetomonitor "$dst" "$mon"
    taken[$dst]=1
    unset "taken[$src]"   # src is empty now; a later pass may change_id onto it
    remap_name "$src" "$dst"
  }

  notify() { # headline — coalesced: at most one notification per 2 seconds
    local stamp="${PLONK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/plonk}/last-notify" now last
    now=$(date +%s)
    if [[ -f $stamp ]]; then
      last=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
      ((now - last < 2)) && return 0
    fi
    mkdir -p "${stamp%/*}" 2>/dev/null && touch "$stamp" 2>/dev/null
    if command -v omarchy-notification-send >/dev/null; then
      omarchy-notification-send --app-name plonk -g 󰕴 -u low "plonk" "$1" -t 1500 >/dev/null 2>&1 || true
    elif command -v notify-send >/dev/null; then
      notify-send -a plonk -u low -t 1500 "plonk" "$1" >/dev/null 2>&1 || true
    fi
  }

  active_windows=$(jq -r --argjson a "$active" '[.[] | select(.id == $a) | .windows] | first // 0' <<<"$workspaces")
  skip_target=0
  if ((keep_empty_active && active > 0 && active_windows == 0)); then
    skip_target=$active
  fi

  target=1
  active_seen=0
  while IFS=$'\t' read -r ws mon; do
    [[ $ws =~ ^[0-9]+$ ]] || continue
    ((ws == active)) && active_seen=1
    while ((skip_target != 0 && target == skip_target)) || [[ -n ${blocked[$target]+x} ]]; do
      target=$((target + 1))
    done
    if ((ws != target)); then
      if ((dry)); then
        echo "would move workspace $ws -> $target ($mon)"
      else
        renumber "$ws" "$target" "$mon"
        if ((quiet)); then echo "plonk: moved workspace $ws -> $target ($mon)" >&2
        else echo "moved workspace $ws -> $target ($mon)"; fi
      fi
      if ((ws == active)); then new_active=$target; fi
      moves=$((moves + 1))
    fi
    target=$((target + 1))
  done < <(jq -r '.[] | select(.id > 0 and .windows > 0 and ((.name // "") | test("^[0-9]+$"))) | "\(.id)\t\(.monitor)"' <<<"$workspaces" | sort -n)

  # Sitting on an empty workspace above the pack? Land on the first free slot.
  if ((keep_empty_active == 0 && active_seen == 0 && active > target)); then
    new_active=$target
    ((dry)) && echo "would move focus $active -> $target (empty workspace)"
  fi

  if ((dry == 0 && new_active != active)); then
    hypr_dispatch "hl.dsp.focus({ workspace = \"$new_active\" })" workspace "$new_active"
  fi
  if ((moves == 0)); then
    ((quiet)) || echo "plonk: already compact"
    if ((dry == 0 && quiet == 0)); then notify "already compact"; fi
  elif ((dry == 0 && (notify_en || quiet == 0))); then
    notify "moved $moves workspace$( ((moves == 1)) || echo s )"
  fi
}

watch_connection() {
  local dir inst sock
  dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr"
  inst=${HYPRLAND_INSTANCE_SIGNATURE:-}
  sock="${dir}/${inst}/.socket2.sock"
  if [[ -z $inst || ! -S $sock ]]; then
    sock=$(find "$dir" -maxdepth 2 -name '.socket2.sock' -type s -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk '{print $2; exit}')
  fi
  [[ -n ${sock:-} && -S $sock ]] || { echo "plonk: Hyprland event socket not found (${sock:-$dir})" >&2; return 1; }
  local paused=0 line ev payload need extra extra_ev rounds
  # Settle for a bounded slice of WALL CLOCK (not "until the stream goes
  # idle"): Hyprland streams windowtitle events continuously (terminal title
  # spinners, browsers), so an idle-based read -t never returns and the
  # watcher would sit here forever, never compacting.
  drain() {
    local budget_us=${PLONK_SETTLE_US:-250000} now left
    local deadline=$(( ${EPOCHREALTIME//[.,]/} + budget_us ))
    while :; do
      now=${EPOCHREALTIME//[.,]/}
      left=$((deadline - now))
      ((left > 0)) || break
      printf -v left '%d.%06d' $((left / 1000000)) $((left % 1000000))
      IFS= read -r -t "$left" extra || break
      extra_ev=${extra%%>>*}
      case "$extra_ev" in
        openlayer)  [[ ${extra#*>>} == hyprshell_switch ]] && paused=1 ;;
        closelayer) [[ ${extra#*>>} == hyprshell_switch ]] && { paused=0; need=1; } ;;
        # A hole that opens while we are settling must not be swallowed:
        # flag it so the loop below compacts again once this slice is over.
        closewindow|movewindow|movewindowv2|destroyworkspace|destroyworkspacev2|monitorremoved)
          need=1 ;;
      esac
    done
  }

  need=0
  while IFS= read -r line; do
    ev=${line%%>>*}
    payload=${line#*>>}
    case "$ev" in
      openlayer)  [[ $payload == hyprshell_switch ]] && paused=1 ;;
      closelayer)
        if [[ $payload == hyprshell_switch ]]; then
          paused=0
          need=1
        fi
        ;;
      closewindow|movewindow|movewindowv2|destroyworkspace|destroyworkspacev2|monitorremoved)
        need=1 ;;
    esac
    # Settle, compact, then settle again to swallow our own change_id
    # events. If real triggers arrived meanwhile (drain sets need), go round
    # again — a compact on an already-compact desktop is a cheap no-op, so
    # this converges; bounded anyway.
    # A pause set by openlayer can stick forever (daemon started while the
    # overlay was up, closelayer missed). Before letting it block a compact,
    # check whether the hyprshell layer actually exists.
    if ((need && paused)); then
      hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | .namespace? // empty] | any(. == "hyprshell_switch")' >/dev/null 2>&1 || paused=0
    fi
    rounds=0
    while ((need && paused == 0 && rounds < 5)); do
      need=0
      rounds=$((rounds + 1))
      drain
      ((paused)) && break
      compact || true
      drain
    done
  done < <(socat -u UNIX-CONNECT:"$sock" -)
}

watch() {
  command -v socat >/dev/null || { echo "plonk: socat not found (needed for --watch)" >&2; return 1; }

  while true; do
    watch_connection || true
    echo "plonk: event socket closed; reconnecting" >&2
    sleep "${PLONK_RECONNECT_DELAY:-1}"
  done
}

if ((watch)); then
  watch
else
  compact
fi
